# Send only the serving code and locked dependencies to the build daemon.
**
!Dockerfile
!requirements-app.lock
!app/
!app/**
!agentic_analytics/
!agentic_analytics/**
!tools/
!tools/**
!data_pipeline/
!data_pipeline/evds/
!data_pipeline/evds/acquisition.py
!data_pipeline/catalog/
!data_pipeline/catalog/evds_series_catalog.parquet

# These stay excluded even inside an allowed source directory.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/.DS_Store
