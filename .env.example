# Copy to .env and set the key locally. Compose passes it at runtime only.
MIA_API_KEY=
MIA_BASE_URL=https://mia.csp.kloudeks.com/v1

# Model routing. Chat can be switched independently without replacing the
# embedding and OCR models used by retrieval and document extraction.
MIA_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
MIA_EMBEDDING_MODEL=kkbhackathon2026/Qwen3-Embedding-8B
MIA_OCR_MODEL=kkbhackathon2026/Unlimited-OCR

# Use 8871 when the native application already occupies port 8870.
AGENT_PORT=8870

# Directory containing analytics.duckdb. Use forward slashes on Windows.
LAKEHOUSE_DIR=./data_pipeline/lakehouse

# Compose includes a private SearXNG service. Override only for another instance.
# Native Python runs use http://127.0.0.1:8888 after starting that service.
SEARXNG_URL=
SEARCH_PORT=8888
